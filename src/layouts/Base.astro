---
import '@fontsource-variable/public-sans';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import mainFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {locales, localizedPath, localePath} from '../i18n/locales';
import content from '../content/site.json';
interface Props { title?: string; description?: string; }
const { title = 'Say YES to Good Government. Vote NO on EE.', description = content.description } = Astro.props;
const {path} = localePath(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006341" />
    {content.draft && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} | {content.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locales.map(code => <link rel="alternate" hreflang={code} href={new URL(localizedPath(path,code), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path,Astro.site)} />
    <link rel="preload" href={mainFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
